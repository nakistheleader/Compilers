START=S0
S0:
    ? -> S1 //Εφόσον χρειάζεται να ξεκινάει μια μεταβλητή απο ? οτιδήποτε άλλο είναι bad
    * -> BIN
S1:
    [A-Z a-z 0-9]-> S2 // επιτρέπεται οποιαδήποτε είσοδος λατινικού χαρακτήρα η αριθμού ως όνομα μεταβλητής
    * -> BIN // αλλιώς κενή μεταβλητή, λάθος
S2:
    [A-Z a-z 0-9]-> S2 // συνεχίζει το όνομα της μεταβλητής
    \n EOF -> GOOD // έχουμε τουλάχιστον 1 χαρακτήρα άρα good
    * -> BIN // αν οτιδήποτε άλλο, πχ σύμβολο
BIN:
    * -> BIN
    EOF -> BAD
GOOD(OK): 
    EOF -> GOOD
    * -> BIN
