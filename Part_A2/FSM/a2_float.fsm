START=S0

S0: 	// Αρχική κατάσταση, μπορεί να δεχτεί μόνο +, - ή αριθμούς από 0-9.
	- + -> S1 	// Εάν το εισερχόμενο σύμβολο είναι + ή -, μεταβαίνουμε στην κατάσταση S1.
	0-9 -> S2 	// Εάν το εισερχόμενο σύμβολο είναι αριθμός (0-9), μεταβαίνουμε στην κατάσταση S2.
	* -> BIN	// Εάν το εισερχόμενο σύμβολο είναι οτιδήποτε άλλο, μεταβαίνουμε στην κατάσταση BIN.

S1: 	// Αν έχουμε ήδη προσδιορίσει το πρόσημο (+ ή -), περιμένουμε αριθμούς.
	0-9 -> S2 	// Εάν το εισερχόμενο σύμβολο είναι αριθμός (0-9), μεταβαίνουμε στην κατάσταση S2.
	* -> BIN	// Εάν το εισερχόμενο σύμβολο είναι οτιδήποτε άλλο, μεταβαίνουμε στην κατάσταση BIN.

S2: 	// Αν έχουμε έναν αριθμό, περιμένουμε είτε περισσότερους αριθμούς, είτε την υποδιαστολή ή το e E.
	0-9 -> S2 	// Εάν το εισερχόμενο σύμβολο είναι αριθμός (0-9), παραμένουμε στην κατάσταση S2 (συνεχίζουμε να διαβάζουμε αριθμούς).
	. -> S3 	// Εάν το εισερχόμενο σύμβολο είναι ., μεταβαίνουμε στην κατάσταση S3 για να επεξεργαστούμε τη δεκαδική υποδιαστολή.
	e E -> S5 	// Εάν το εισερχόμενο σύμβολο είναι e ή E, μεταβαίνουμε στην κατάσταση S5.
	* -> BIN	// Εάν το εισερχόμενο σύμβολο είναι οτιδήποτε άλλο, μεταβαίνουμε στην κατάσταση BIN.

S3: 	// Αν έχουμε την υποδιαστολή, περιμένουμε έναν αριθμό.
	0-9 -> S4 	// Εάν το εισερχόμενο σύμβολο είναι αριθμός (0-9), μεταβαίνουμε στην κατάσταση S4 για να διαβάσουμε τους αριθμούς μετά την υποδιαστολή.
	* -> BIN	// Εάν το εισερχόμενο σύμβολο είναι οτιδήποτε άλλο, μεταβαίνουμε στην κατάσταση BIN.

S4: 	// Αν έχουμε διαβάσει αριθμούς μετά την υποδιαστολή, περιμένουμε είτε περισσότερους αριθμούς, είτε e E ή το EOF.
	0-9 -> S4 	// Εάν το εισερχόμενο σύμβολο είναι αριθμός (0-9), παραμένουμε στην κατάσταση S4.
	\n -> GOOD 	// Εάν το εισερχόμενο σύμβολο είναι \n, μεταβαίνουμε στην κατάσταση GOOD.
	e E -> S5 	// Εάν το εισερχόμενο σύμβολο είναι e ή E, μεταβαίνουμε στην κατάσταση S5.
	* -> BIN	// Εάν το εισερχόμενο σύμβολο είναι οτιδήποτε άλλο, μεταβαίνουμε στην κατάσταση BIN.

S5: 	// Αν έχουμε διαβάσει e ή E, περιμένουμε έναν αριθμό ή πρόσημο
	0-9 -> S7 	// Εάν το εισερχόμενο σύμβολο είναι αριθμός (0-9), μεταβαίνουμε στην κατάσταση S7 για να διαβάσουμε.
	- + -> S6 	// Εάν το εισερχόμενο σύμβολο είναι πρόσημο (- ή +), μεταβαίνουμε στην κατάσταση S6.
	* -> BIN	// Εάν το εισερχόμενο σύμβολο είναι οτιδήποτε άλλο, μεταβαίνουμε στην κατάσταση BIN.

S6: 	// Αν έχουμε διαβάσει το πρόσημο, περιμένουμε αριθμούς
	0-9 -> S7 	// Εάν το εισερχόμενο σύμβολο είναι αριθμός (0-9), μεταβαίνουμε στην κατάσταση S7.
	* -> BIN	// Εάν το εισερχόμενο σύμβολο είναι οτιδήποτε άλλο, μεταβαίνουμε στην κατάσταση BIN.

S7: 	// Αν έχουμε διαβάσει e ή E, περιμένουμε είτε περισσότερους αριθμούς είτε το τέλος της γραμμής ή οτιδήποτε άλλο που θα δεχτούμε θα μας πάει στο BIN.
	0-9 -> S7 	// Εάν το εισερχόμενο σύμβολο είναι αριθμός (0-9), παραμένουμε στην κατάσταση S7.
	* -> BIN	// Εάν το εισερχόμενο σύμβολο είναι οτιδήποτε άλλο, μεταβαίνουμε στην κατάσταση BIN.
	\n -> GOOD 	// Εάν το εισερχόμενο σύμβολο είναι \n, μεταβαίνουμε στην κατάσταση GOOD.

BIN: 	// Κατάσταση για μη έγκυρες εισόδους, παραμένουμε στην κατάσταση BIN μέχρι να συναντήσουμε EOF.
	* -> BIN 	// Αν συνεχίσουμε να εισάγουμε οτιδήποτε άλλο, παραμένουμε στην κατάσταση BIN.
	EOF -> BAD	// Αν φτάσουμε στο τέλος του αρχείου (EOF), μεταβαίνουμε στην κατάσταση BAD μη έγκυρη είσοδος.

GOOD(OK): // Κατάσταση για έγκυρες εισόδους, παραμένουμε στην κατάσταση GOOD μέχρι να φτάσουμε στο EOF.
	EOF -> GOOD 	// Αν φτάσουμε στο EOF, παραμένουμε στην κατάσταση GOOD έγκυρη είσοδος.
	* -> BIN	// Αν το εισερχόμενο σύμβολο είναι οτιδήποτε άλλο, μεταβαίνουμε στην κατάσταση BIN.
