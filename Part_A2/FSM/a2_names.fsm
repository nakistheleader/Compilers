START=S0
S0:
    [A-Z a-z] -> S1 // τα ονόματα πρέπει να ξεκινάνε με λατινικό χαρακτήρα
    * -> BIN //οτιδήποτε άλλο είναι λάθος
S1:
    [A-Z a-z 0-9]-> S1 // συνεχίζει το όνομα
    - _ -> S2 //παύλα επιτρέπεται και εδώ τσεκάρουμε αν μπήκε
    \n EOF -> GOOD 
    * -> BIN
S2:
    [A-Z a-z 0-9] -> S1 // συνεχίζει το όνομα αλλα υπάρχει παύλα
    - _ -> S2 // νέα παύλα
    * -> BIN //οτιδήποτε αλλο λάθος
BIN:
    * -> BIN
    EOF -> BAD
GOOD(OK): 
    EOF -> GOOD
    * -> BIN
