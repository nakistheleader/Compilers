START=S0
S0:
    " -> S1 // Χρειάζεται να αρχίζει με το σύμβολο " αλλιώς δεν είναι σχόλιο
    * -> BIN
S1:
    " -> S3 // Αν είναι η κενή συμβολοσειρά
    \\ -> S2 // backslash
    * -> S1 // Αν είναι οτιδήποτε παραμένουμε στην S1
    \n EOF -> BIN
S2:
    \\ " n -> S1 // αν είναι κάποιος χαρακτήρας που χρειάζεται backslash
    * -> BIN // αλλιώς λάθος
S3:
    \n -> GOOD // κενή συμβολοσειρά και έξοδος
    * -> BIN // αλλιώς λάθος
BIN:
    EOF -> BAD
    * -> BIN
GOOD(OK):
    EOF -> GOOD
    * -> BIN
