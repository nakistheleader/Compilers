START=S0
S0:
    ; -> COMMENTS
    " -> STRINGS
    - +  -> NUM_S1 
    0    -> NUM_S2  
    1-9  -> NUM_S3
    \s \t -> S0
    ( )       -> PARENTHESIS
    \n EOF    -> GOOD
    ?         -> VAR
    [A-Z a-z] -> NAMES_S1
    * -> BIN

STRINGS:
    "      -> STRINGS_S1
    \\     -> STRINGS_S2
    *      -> STRINGS
    \n     -> BIN
STRINGS_S1:
    \n     -> GOOD
    * EOF  -> BIN
STRINGS_S2:
    \\ " n -> STRINGS
    *      -> BIN

COMMENTS:
    *       -> COMMENTS
    \n, EOF -> GOOD

NUM_S1:
    0    -> ZERO
    1-9  -> NUM_S3
    *    -> BIN

ZERO:
    .    -> NUM_S4
    e E  -> NUM_INT
    *    -> BIN

NUM_S2:
    .    -> NUM_S4
    e E  -> NUM_INT
    \n   -> GOOD  
    *    -> BIN
NUM_S3:
    0-9  -> NUM_S3  
    .    -> NUM_S4
    e E  -> NUM_INT
    \n   -> GOOD  
    *    -> BIN

NUM_S4: 	
	0-9  -> NUM_S5
	*    -> BIN
	
NUM_S5: 	
	0-9  -> NUM_S5
	\n   -> GOOD
	e E  -> NUM_FLOAT
	*    -> BIN

NUM_INT:
    - +  -> NUM_INT2
    0-9  -> NUM_INT3
    *    -> BIN

NUM_INT2:
    0-9  -> NUM_INT3
    *    -> BIN

NUM_INT3:
    0-9  -> NUM_INT3
    \n   -> GOOD
	*    -> BIN

NUM_FLOAT:
    - +  -> NUM_FLOAT3
    0-9  -> NUM_FLOAT2
    *    -> BIN

NUM_FLOAT2:
	0-9  -> NUM_FLOAT2
    \n   -> GOOD
	*    -> BIN

NUM_FLOAT3:
    0-9  -> NUM_FLOAT2
	*    -> BIN

PARENTHESIS:
    \n EOF -> GOOD
    *      -> BIN

VAR:
    [A-Z a-z 0-9] -> VAR
    \n, EOF       -> GOOD
    *             -> BIN

NAMES_S1:
    [A-Z a-z 0-9] -> NAMES_S1
    - _           -> NAMES_S2
    \n, EOF       -> GOOD
    *             -> BIN
NAMES_S2:
    [A-Z a-z 0-9] -> NAMES_S1
    - _           -> NAMES_S2
    *             -> BIN

BIN:
    *     -> BIN
    EOF   -> BAD

GOOD(OK): 
    EOF   -> GOOD
    *     -> BIN
