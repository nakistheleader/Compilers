START=S0
S0:
    ; -> COMMENTS
    +    -> NUM_S1  
    -    -> NUM_S1  
    0    -> NUM_S2  
    1-9  -> NUM_S3  
    \s \t -> S0
    \n ( ) EOF -> GOOD
    " -> STRINGS
    ? -> VAR
    [A-Z a-z] -> NAMES_S1
    * -> BIN

STRINGS:
    " -> STRINGS_S1
    \\ -> STRINGS_S1
    * -> STRINGS
    \n -> BIN
STRINGS_S1:
    \\ " n -> STRINGS
    \n   -> GOOD
    * -> BIN


COMMENTS:
    * -> COMMENTS
    \n, EOF -> GOOD

NUM_S1:
    0    -> ZERO
    1-9  -> NUM_S3  
    \n   -> BIN
    *    -> BIN

ZERO:
    \n   -> BIN
    .    -> NUM_S4
    e E  -> NUM_S4

NUM_S2:
    .    -> NUM_S4
    e E  -> NUM_S4
    \n   -> GOOD  
    *    -> BIN
NUM_S3:
    0-9  -> NUM_S3  
    .    -> NUM_S4
    e E  -> NUM_S4
    \n   -> GOOD  
    *    -> BIN
NUM_S4: 	
	0-9 -> NUM_S5
	* -> BIN
	
NUM_S5: 	
	0-9 -> NUM_S5
	\n -> GOOD
	e E -> NUM_S6
	* -> BIN
	
NUM_S6: 	
	0-9 -> NUM_S8
	- + -> NUM_S7
    \n  -> GOOD
	* -> BIN
	
NUM_S7: 	
	0-9 -> NUM_S8
	* -> BIN

NUM_S8: 	
	0-9 -> NUM_S8
	* -> BIN
	\n -> GOOD


VAR:
    [A-Z a-z 0-9]-> VAR
    \n, EOF -> GOOD
    * -> BIN

NAMES_S1:
    [A-Z a-z 0-9]-> NAMES_S1
    - _ -> NAMES_S2
    \n, EOF -> GOOD
    * -> BIN
NAMES_S2:
    [A-Z a-z 0-9] -> NAMES_S1
    - _ -> NAMES_S2
    * -> BIN

BIN:
    * -> BIN
    EOF -> BAD

GOOD(OK): 
    EOF -> GOOD
    * -> BIN
